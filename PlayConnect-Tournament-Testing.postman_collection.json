    {
      "name": "Test Tournament Join Validation",
      "item": [
        {
          "name": "Thunder Bolts Joins 18+ Football (Should Fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{alexToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": \"{{thunderBoltsTeamId}}\"\n}"
            },
            "url": {
              "raw": "{{baseURL}}/api/tournaments/{{footballTournamentId}}/join",
              "host": ["{{baseURL}}"],
              "path": ["api", "tournaments", "{{footballTournamentId}}", "join"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should be rejected due to age\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.status).to.eql(\"rejected\");",
                  "    pm.expect(responseJson.failures).to.include(\"age-below-min\");",
                  "});"
                ]
              }
            }
          ]
        },
